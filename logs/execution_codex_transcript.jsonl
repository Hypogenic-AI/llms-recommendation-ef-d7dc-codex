{"type":"item.started","item":{"id":"item_95","type":"command_execution","command":"/bin/bash -lc \"source .venv/bin/activate && python - <<'PY'\nimport json\nimport pandas as pd\nfrom pathlib import Path\n\nexamples = {}\nfor path in ['results/lastfm_examples.json','results/mpd_examples.json']:\n    for row in json.load(open(path)):\n        examples[row['example_id']] = row\nfor ds in ['lastfm','mpd']:\n    df = pd.read_csv(f'results/{ds}/per_example_metrics.csv')\n    pivot = df.pivot(index='example_id', columns='method', values='rr')\n    pivot['openai_gain'] = pivot['openai_minimal'] - pivot['cooccurrence']\n    pivot['claude_gain'] = pivot['claude_minimal'] - pivot['cooccurrence']\n    print('\\\\nDATASET', ds, 'best_openai_vs_baseline')\n    for ex_id in pivot.sort_values('openai_gain', ascending=False).head(3).index:\n        ex = examples[ex_id]\n        print(ex_id, 'gain', round(pivot.loc[ex_id,'openai_gain'],4), 'history', ex['history'][:5], 'target', ex['target_label'])\n    print('\\\\nDATASET', ds, 'worst_openai_vs_baseline')\n    for ex_id in pivot.sort_values('openai_gain', ascending=True).head(3).index:\n        ex = examples[ex_id]\n        print(ex_id, 'gain', round(pivot.loc[ex_id,'openai_gain'],4), 'history', ex['history'][:5], 'target', ex['target_label'])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
