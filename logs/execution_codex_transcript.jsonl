{"type":"item.started","item":{"id":"item_93","type":"command_execution","command":"/bin/bash -lc \"source .venv/bin/activate && python - <<'PY'\nimport pandas as pd\nfrom scipy.stats import wilcoxon\nfor ds in ['lastfm','mpd']:\n    df = pd.read_csv(f'results/{ds}/per_example_metrics.csv')\n    print('\\\\nDATASET', ds)\n    for a,b in [('claude_minimal','claude_profile'),('openai_minimal','openai_profile'),('claude_minimal','openai_minimal')]:\n        fa = df[df.method==a].set_index('example_id')\n        fb = df[df.method==b].set_index('example_id')\n        j = fa.join(fb, lsuffix='_a', rsuffix='_b')\n        for metric in ['rr','ndcg10','hit10']:\n            stat,p = wilcoxon(j[f'{metric}_a'], j[f'{metric}_b'], zero_method='wilcox', alternative='two-sided')\n            print(a,b,metric,'mean_a',round(j[f'{metric}_a'].mean(),4),'mean_b',round(j[f'{metric}_b'].mean(),4),'p',p)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
